<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.2-ea" fx:controller="com.example.demo.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <AnchorPane prefHeight="200.0" prefWidth="200.0">
      <children>
         <AnchorPane layoutX="209.0" prefHeight="200.0" prefWidth="240.0">
            <children>
               <Button layoutX="26.0" layoutY="14.0" mnemonicParsing="false" prefHeight="25.0" prefWidth="94.0" text="Hozzáad">
                  <graphic>
                     <ImageView fitHeight="16.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                           <Image url="@../../../../assets/add16.png" />
                        </image>
                     </ImageView>
                  </graphic>
               </Button>
               <Button layoutX="132.0" layoutY="14.0" mnemonicParsing="false" prefHeight="25.0" prefWidth="94.0" text="Töröl">
                  <graphic>
                     <ImageView fitHeight="16.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                           <Image url="@../../../../assets/del16.png" />
                        </image>
                     </ImageView>
                  </graphic>
               </Button>
               <ListView layoutX="26.0" layoutY="47.0" prefHeight="200.0" prefWidth="200.0" />
               <Button layoutX="85.0" layoutY="258.0" mnemonicParsing="false" prefHeight="25.0" prefWidth="82.0" text="Mentés">
                  <graphic>
                     <ImageView fitHeight="16.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                           <Image url="@../../../../assets/save16.png" />
                        </image>
                     </ImageView>
                  </graphic>
               </Button>
            </children>
         </AnchorPane>
         <AnchorPane prefHeight="283.0" prefWidth="205.0">
            <children>
               <RadioButton layoutX="14.0" layoutY="14.0" mnemonicParsing="false" text="Piros">
                  <toggleGroup>
                     <ToggleGroup fx:id="szinek" />
                  </toggleGroup>
               </RadioButton>
               <RadioButton layoutX="14.0" layoutY="40.0" mnemonicParsing="false" text="Zöld" toggleGroup="$szinek" />
               <RadioButton layoutX="14.0" layoutY="67.0" mnemonicParsing="false" text="Kék" toggleGroup="$szinek" />
               <RadioButton layoutX="113.0" layoutY="14.0" mnemonicParsing="false" text="Négyzet">
                  <toggleGroup>
                     <ToggleGroup fx:id="alakzatok" />
                  </toggleGroup>
               </RadioButton>
               <RadioButton layoutX="113.0" layoutY="40.0" mnemonicParsing="false" text="Kör" toggleGroup="$alakzatok" />
               <RadioButton layoutX="113.0" layoutY="67.0" mnemonicParsing="false" text="Háromszög" toggleGroup="$alakzatok" />
            </children>
         </AnchorPane>
      </children>
   </AnchorPane>
</VBox>
